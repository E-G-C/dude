{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Strata design tokens. One structural system, two colour palettes (pigment, spectrum) x two themes. Token ids are role-based: series-N and the semantic roles are the ids; mineral and spectral names are documentation only. All four palette/theme branches expose an identical id set, which strata-check asserts. Framework-agnostic and unaffiliated with any company, product, or design system. See ../reference/provenance-and-licensing.md.",
  "space": {
    "0": {
      "$value": "0px",
      "$type": "dimension"
    },
    "1": {
      "$value": "4px",
      "$type": "dimension"
    },
    "2": {
      "$value": "8px",
      "$type": "dimension"
    },
    "3": {
      "$value": "12px",
      "$type": "dimension"
    },
    "4": {
      "$value": "16px",
      "$type": "dimension"
    },
    "5": {
