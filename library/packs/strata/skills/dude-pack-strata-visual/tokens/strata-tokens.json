      "enter": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)",
        "$type": "cubicBezier"
      },
      "exit": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)",
        "$type": "cubicBezier",
        "$description": "Declared as an explicit cubic-bezier. A CSS keyword must never be used as a token value: `ease-out` means exactly cubic-bezier(0, 0, 0.58, 1), and the keyword hides that from cross-format comparison."
      }
    }
