      "$type": "dimension"
    },
    "6": {
      "$value": "32px",
      "$type": "dimension"
    },
    "7": {
      "$value": "48px",
      "$type": "dimension"
    },
    "8": {
      "$value": "64px",
      "$type": "dimension"
    }
  },
  "radius": {
    "$description": "4px is the interactive default; 8px the maximum for large containers; pill is retained and discouraged.",
