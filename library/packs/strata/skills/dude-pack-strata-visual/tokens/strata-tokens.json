    },
    "muted": {
      "$value": "#A2A9B4",
      "$type": "color",
      "$description": "7.92:1 on code.bg. Never use the plane muted token on the code surface."
    }
  },
  "plane": {
    "$description": "Replaces the old three-step blur-shadow elevation ramp. A plane is legible from its tone and its 1px edge - and on a white or near-white ground the tone contributes almost nothing, so the edge is mandatory. There is no shadow token because there is no shadow.",
