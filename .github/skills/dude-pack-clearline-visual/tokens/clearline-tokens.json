{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Clearline visual tokens. See ../reference/sources.md.",
  "color": {
    "accent": {
      "blue": { "$value": "#00A4EF", "$type": "color", "$description": "Decorative cool accent; default primary signal." },
      "green": { "$value": "#7FBA00", "$type": "color", "$description": "Decorative natural accent; default success signal." },
      "orange": { "$value": "#FFB900", "$type": "color", "$description": "Decorative warm accent; default warning signal." },
      "red": { "$value": "#F25022", "$type": "color", "$description": "Decorative warm accent; default danger signal." }
    },
    "neutral": {
      "bg": { "$value": "#FFFFFF", "$type": "color" },
      "bg-subtle": { "$value": "#F3F2F1", "$type": "color" },
      "bg-dark": { "$value": "#1B1A19", "$type": "color" },
      "bg-subtle-dark": { "$value": "#2B2A29", "$type": "color" },
      "gray": { "$value": "#737373", "$type": "color", "$description": "Neutral support ink for wordmarks and marks on light surfaces." },
      "border": { "$value": "#E1DFDD", "$type": "color" },
      "border-dark": { "$value": "#737373", "$type": "color" },
      "text": { "$value": "#201F1E", "$type": "color" },
      "text-muted": { "$value": "#605E5C", "$type": "color" },
      "text-muted-dark": { "$value": "#C8C6C4", "$type": "color" },
      "text-on-dark": { "$value": "#FFFFFF", "$type": "color" }
    },
    "semantic": {
      "primary": {
        "background": { "$value": "#0067B8", "$type": "color" },
        "foreground": { "$value": "{color.neutral.text-on-dark}", "$type": "color" }
      },
      "success": {
        "background": { "$value": "#107C10", "$type": "color" },
        "foreground": { "$value": "{color.neutral.text-on-dark}", "$type": "color" }
      },
      "warning": {
        "background": { "$value": "#7A5800", "$type": "color" },
        "foreground": { "$value": "{color.neutral.text-on-dark}", "$type": "color" }
      },
      "danger": {
        "background": { "$value": "#A4262C", "$type": "color" },
        "foreground": { "$value": "{color.neutral.text-on-dark}", "$type": "color" }
      },
      "control": {
        "border": { "$value": "#767676", "$type": "color", "$description": "Essential boundary on light Clearline surfaces." },
        "border-on-dark": { "$value": "#A19F9D", "$type": "color", "$description": "Essential boundary on dark Clearline surfaces." }
      },
      "link": {
        "foreground": { "$value": "#0065B3", "$type": "color" },
        "foreground-on-dark": { "$value": "#75B6E7", "$type": "color" }
      },
      "focus": {
        "ring": { "$value": "#005A9E", "$type": "color" },
        "halo": { "$value": "#FFFFFF", "$type": "color" },
        "ring-on-dark": { "$value": "#75B6E7", "$type": "color" },
        "halo-on-dark": { "$value": "#1B1A19", "$type": "color" }
      }
    }
  },
  "font": {
    "family": {
      "body": { "$value": "Inter, \"Inter Variable\", system-ui, -apple-system, \"Helvetica Neue\", Helvetica, Arial, sans-serif", "$type": "fontFamily" },
      "heading": { "$value": "Inter, \"Inter Variable\", system-ui, -apple-system, \"Helvetica Neue\", Helvetica, Arial, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "\"JetBrains Mono\", \"JetBrains Mono NL\", ui-monospace, SFMono-Regular, Menlo, \"Liberation Mono\", \"DejaVu Sans Mono\", monospace", "$type": "fontFamily" },
      "docs": { "$value": "Inter, \"Inter Variable\", system-ui, -apple-system, \"Helvetica Neue\", Helvetica, Arial, sans-serif", "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" }
    },
    "size": {
      "display": { "$value": "48px", "$type": "dimension" },
      "h1": { "$value": "36px", "$type": "dimension" },
      "h2": { "$value": "28px", "$type": "dimension" },
      "h3": { "$value": "22px", "$type": "dimension" },
      "h4": { "$value": "18px", "$type": "dimension" },
      "body-lg": { "$value": "18px", "$type": "dimension" },
      "body": { "$value": "16px", "$type": "dimension" },
      "caption": { "$value": "13px", "$type": "dimension" },
      "micro": { "$value": "11px", "$type": "dimension" }
    },
    "lineHeight": {
      "display": { "$value": 1.15, "$type": "number" },
      "h1": { "$value": 1.2, "$type": "number" },
      "h2": { "$value": 1.25, "$type": "number" },
      "h3": { "$value": 1.3, "$type": "number" },
      "h4": { "$value": 1.35, "$type": "number" },
      "body": { "$value": 1.5, "$type": "number" },
      "caption": { "$value": 1.4, "$type": "number" },
      "micro": { "$value": 1.3, "$type": "number" },
      "tight": { "$value": "{font.lineHeight.h1}", "$type": "number" },
      "normal": { "$value": "{font.lineHeight.body}", "$type": "number" }
    }
  },
  "docs": {
    "pageWidth": { "$value": "1280px", "$type": "dimension", "$description": "Page shell for mastheads, footers, and full-width bands." },
    "contentWidth": { "$value": "1200px", "$type": "dimension", "$description": "Article column and widest child tier." },
    "figureWidth": { "$value": "1200px", "$type": "dimension", "$description": "Figures, diagrams, and image plates." },
    "wideWidth": { "$value": "1064px", "$type": "dimension", "$description": "Tables, code blocks, callouts, and card rows." },
    "readableWidth": { "$value": "928px", "$type": "dimension", "$description": "Prose measure for paragraphs, headings, and lists." },
    "fontSize": {
      "title": { "$value": "40px", "$type": "dimension" },
      "h2": { "$value": "32px", "$type": "dimension" },
      "h3": { "$value": "28px", "$type": "dimension" },
      "body": { "$value": "16px", "$type": "dimension" },
      "compact": { "$value": "14px", "$type": "dimension" },
      "code": { "$value": "14px", "$type": "dimension" }
    },
    "lineHeight": {
      "title": { "$value": "52px", "$type": "dimension" },
      "h2": { "$value": 1.3, "$type": "number" },
      "h3": { "$value": 1.3, "$type": "number" },
      "body": { "$value": "28px", "$type": "dimension" },
      "list": { "$value": 1.8, "$type": "number" },
      "compact": { "$value": 1.5, "$type": "number" },
      "code": { "$value": "19px", "$type": "dimension" }
    },
    "color": {
      "link": { "$value": "{color.semantic.link.foreground}", "$type": "color" },
      "link-on-dark": { "$value": "{color.semantic.link.foreground-on-dark}", "$type": "color" },
      "code-bg": { "$value": "{color.neutral.bg-subtle}", "$type": "color" },
      "code-bg-dark": { "$value": "#404040", "$type": "color" },
      "tip-bg": { "$value": "#DFF6DD", "$type": "color" },
      "tip-border": { "$value": "{color.semantic.success.background}", "$type": "color" },
      "tip-bg-dark": { "$value": "#054B16", "$type": "color" },
      "tip-text-dark": { "$value": "#DFF6DD", "$type": "color" }
    }
  },
  "space": {
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "24px", "$type": "dimension" },
    "6": { "$value": "32px", "$type": "dimension" },
    "7": { "$value": "48px", "$type": "dimension" },
    "8": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "2px", "$type": "dimension" },
    "md": { "$value": "4px", "$type": "dimension" },
    "lg": { "$value": "8px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "component": {
    "control": {
      "height": {
        "compact": { "$value": "32px", "$type": "dimension" },
        "default": { "$value": "40px", "$type": "dimension" },
        "touch": { "$value": "48px", "$type": "dimension" }
      },
      "borderWidth": { "$value": "1px", "$type": "dimension" }
    },
    "card": {
      "minWidth": { "$value": "240px", "$type": "dimension" }
    },
    "focus": {
      "ringWidth": { "$value": "2px", "$type": "dimension" },
      "ringOffset": { "$value": "2px", "$type": "dimension" }
    }
  },
  "mark": {
    "size": {
      "compact": { "$value": "16px", "$type": "dimension" },
      "default": { "$value": "24px", "$type": "dimension" },
      "hero": { "$value": "40px", "$type": "dimension" }
    },
    "clearSpace": {
      "compact": { "$value": "{mark.size.compact}", "$type": "dimension", "$description": "Outer padding around a compact mark-only or mark-and-wordmark lockup." },
      "default": { "$value": "{mark.size.default}", "$type": "dimension", "$description": "Outer padding around a default mark-only or mark-and-wordmark lockup." },
      "hero": { "$value": "{mark.size.hero}", "$type": "dimension", "$description": "Outer padding around a hero mark-only or mark-and-wordmark lockup." }
    }
  },
  "elevation": {
    "1": { "$value": "0 1px 2px rgba(0,0,0,0.08)", "$type": "shadow" },
    "2": { "$value": "0 2px 6px rgba(0,0,0,0.10)", "$type": "shadow" },
    "3": { "$value": "0 4px 12px rgba(0,0,0,0.12)", "$type": "shadow" }
  },
  "motion": {
    "duration": {
      "none": { "$value": "0ms", "$type": "duration" },
      "reduced": { "$value": "1ms", "$type": "duration" },
      "micro": { "$value": "150ms", "$type": "duration" },
      "standard": { "$value": "250ms", "$type": "duration" },
      "entrance": { "$value": "400ms", "$type": "duration" }
    },
    "easing": {
      "enter": { "$value": "cubic-bezier(0.1, 0.9, 0.2, 1)", "$type": "cubicBezier" },
      "exit": { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$type": "cubicBezier" }
    }
  }
}
